@startuml C4_Database_Schema
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Charter Flight Management System - Database Schema

Container_Boundary(databases, "Data Storage Layer") {
    ContainerDb(postgres, "PostgreSQL", "Relational Data", "
    Vuelo (Flights)
    Aeronave (Aircraft)
    TripulanteComponent (Crew)
    Personal (Staff)
    Usuario (Users)
    Mantenimiento (Maintenance)
    Repostaje (Refueling)
    Incidencia (Incidents)
    RegistroHorasVuelo (Flight Hours)
    PasajeroVuelo (Passengers)
    Pago (Payments)
    AutenticacionDosFactor (2FA)
    ")
    
    ContainerDb(mongodb, "MongoDB", "Document Data", "
    Flight Logs
    Audit Trails
    Configuration
    Templates
    Payment Records
    Security Events (2FA, reCAPTCHA)
    ")
}

@enduml

@startuml C4_Deployment
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Charter Flight Management System - Deployment Diagram

Deployment_Node(client, "Client Machine", "Windows/Mac/Linux") {
    Container(browser, "Web Browser", "Chrome/Firefox/Safari", "Hosts the Angular application")
}

Deployment_Node(internet, "Internet")

Deployment_Node(aws, "AWS Cloud (PRIMARY PRODUCTION)", "us-east-1") {
    Deployment_Node(aws_compute, "EC2 Instance", "t3.large, Linux, Docker") {
        Deployment_Node(aws_springboot, "Spring Boot Container", "Java 21, Gradle") {
            Container(aws_api, "REST API", "Spring Boot 4.0.2", "Primary application server")
        }
    }
    
    Deployment_Node(aws_rds, "Amazon RDS", "Managed Relational Database") {
        Container(aws_postgres, "PostgreSQL 15+", "Database", "Primary relational database")
    }
    
    Deployment_Node(aws_nosql, "AWS Services", "Data & Integration") {
        Container(aws_mongodb, "MongoDB Atlas", "Database", "Primary document database")
        Container(aws_cloudinary, "Cloudinary", "CDN", "Image storage & delivery")
        Container(aws_mercadopago, "Mercado Pago Integration", "Payment", "Payment processing")
        Container(aws_recaptcha, "Google reCAPTCHA", "Security", "Bot detection")
        Container(aws_twofa, "2FA Service", "Security", "Two-factor authentication")
    }
}

Deployment_Node(azure, "Azure Cloud (BACKUP/DISASTER RECOVERY)", "East US") {
    Deployment_Node(azure_compute, "Virtual Machine", "Standard_B2s, Linux, Docker") {
        Deployment_Node(azure_springboot, "Spring Boot Container (Standby)", "Java 21, Gradle") {
            Container(azure_api, "REST API (Backup)", "Spring Boot 4.0.2", "Backup application server")
        }
    }
    
    Deployment_Node(azure_db, "Azure SQL & Services", "Managed Databases") {
        Container(azure_postgres, "PostgreSQL (Azure DB)", "Database", "Replicated database (read-only)")
        Container(azure_mongodb, "Cosmos DB (MongoDB API)", "Database", "Replicated database (read-only)")
    }
}

Rel(browser, aws_api, "REST/JSON [HTTPS]", "Primary")
Rel(aws_api, aws_postgres, "SQL [Port 5432]", "Read/Write")
Rel(aws_api, aws_mongodb, "MongoDB Protocol [Port 27017]", "Read/Write")
Rel(aws_api, aws_cloudinary, "HTTPS API", "Upload/Retrieve")
Rel(aws_api, aws_mercadopago, "HTTPS API", "Payment transactions")
Rel(aws_api, aws_recaptcha, "HTTPS API", "Verify bot detection")
Rel(aws_api, aws_twofa, "HTTPS API", "Verify 2FA codes")
Rel(aws_postgres, azure_postgres, "Continuous Replication", "Failover data")
Rel(aws_mongodb, azure_mongodb, "Continuous Replication", "Failover data")
Rel(aws_api, azure_api, "Health Check & Sync", "Periodic")
Rel(browser, azure_api, "REST/JSON [HTTPS]", "Failover (if AWS down)")

@enduml

