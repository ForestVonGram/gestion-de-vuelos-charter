@startuml C4_Context_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Charter Flight Management System - C4 Model - Context Level

Person(admin, "Administrator", "Manages flights, aircraft, and crew")
Person(pilot, "Pilot", "Views assignments and flight details")
Person(client, "Client", "Requests charter flights")

System(cfs, "Charter Flight System", "Full-stack application for managing charter flights, fleet maintenance, and crew administration")

System_Ext(cloudinary, "Cloudinary", "Cloud storage for images and documents")
System_Ext(email, "Email Service", "Sends notifications and confirmations")
System_Ext(mercadopago, "Mercado Pago", "Payment processing for flight reservations")
System_Ext(recaptcha, "Google reCAPTCHA", "Bot detection and form protection")
System_Ext(twofa, "2FA Provider", "Two-factor authentication (OTP via email/SMS)")

Rel(admin, cfs, "Uses")
Rel(pilot, cfs, "Uses")
Rel(client, cfs, "Uses")
Rel(cfs, cloudinary, "Uploads/retrieves images")
Rel(cfs, email, "Sends emails")
Rel(cfs, mercadopago, "Processes payments")
Rel(cfs, recaptcha, "Validates forms")
Rel(cfs, twofa, "Verifies 2FA codes")

@enduml

@startuml C4_Container_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Charter Flight Management System - C4 Model - Container Level

Person(admin, "Administrator")
Person(pilot, "Pilot")
Person(client, "Client")

System_Boundary(cfs, "Charter Flight System") {
    Container(web, "Web Application", "Angular 21, TypeScript 5.9, TailwindCSS 4", "Provides flight management, scheduling, and reporting UX")
    Container(api, "REST API", "Spring Boot 4.0.2, Java 21, Spring Security OAuth2", "Handles business logic, data processing, and authentication")
    ContainerDb(postgres, "PostgreSQL Database", "PostgreSQL", "Stores relational data: flights, aircraft, crew, personnel")
    ContainerDb(mongodb, "MongoDB Database", "MongoDB", "Stores document data and flight logs")
}

System_Ext(cloudinary, "Cloudinary")
System_Ext(email, "Email Service")
System_Ext(mercadopago, "Mercado Pago")
System_Ext(recaptcha, "Google reCAPTCHA")
System_Ext(twofa, "2FA Provider")

Rel(admin, web, "Uses [HTTPS]")
Rel(pilot, web, "Uses [HTTPS]")
Rel(client, web, "Uses [HTTPS]")
Rel(web, api, "Calls [REST/JSON]")
Rel(api, postgres, "Reads/Writes [SQL]")
Rel(api, mongodb, "Reads/Writes [JSON]")
Rel(api, cloudinary, "Uploads/Retrieves [HTTP API]")
Rel(api, email, "Sends [SMTP]")
Rel(api, mercadopago, "Processes payments [HTTPS API]")
Rel(web, recaptcha, "Validates [HTTPS API]")
Rel(api, recaptcha, "Verifies [HTTPS API]")
Rel(api, twofa, "Sends OTP [HTTPS API]")

@enduml

